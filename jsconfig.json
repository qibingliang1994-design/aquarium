{
  // 类型检查：按文件 opt-in（// @ts-check + JSDoc），已转正的文件见 CLAUDE.md；tests 由 vitest 验证
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "tests/**/*.js"]
}
