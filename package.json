{
  "name": "aquarium",
  "private": true,
  "version": "2.2.4",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node _serve.cjs",
    "icons": "node scripts/gen-icons.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^5.2.3",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
